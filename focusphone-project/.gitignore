# Gradle files and caches
.gradle/
build/
/*/build/
kotlin-js-store/

# Local configuration files (contains local SDK paths, keys, etc.)
local.properties

# Android Studio / IntelliJ IDEA files.
# Everything under `.idea/` is per-machine IDE state except the shared code style,
# which is what keeps formatting identical across clones and consistent with
# `.editorconfig` and ktlint. `/.idea/*` rather than `/.idea/`: git cannot re-include
# a file whose parent directory is excluded.
/.idea/*
!/.idea/.gitignore
!/.idea/.name
!/.idea/codeStyles/
*.iml
*.ipr
*.iws

# Built artifacts
*.apk
*.ap_
*.aar
*.jar
# The wrapper JAR must be versioned: without it a clean clone cannot run ./gradlew.
!gradle/wrapper/gradle-wrapper.jar
*.class

# Release outputs (APK, output metadata, baseline profiles) are build artifacts
/app/release/

# Log files
*.log

# OS-specific files
.DS_Store
Thumbs.db
ehthumbs.db

# Device captures and builds
/captures/
.externalNativeBuild/
.cxx/

# Kotlin / Compiler caches
.kotlin/
