    <!-- Tutorial Slides -->
    <string name="tutorial_slide_1_title">minimalisme &amp; accueil</string>
    <string name="tutorial_slide_1_desc">votre écran d\'accueil propre, débarrassé des icônes bruyantes et distrayantes, optimisé pour l\'essentiel.</string>
    <string name="tutorial_slide_2_title">épingler des apps</string>
    <string name="tutorial_slide_2_desc">maintenez un espace vide sur l\'écran d\'accueil ou utilisez le sélecteur de favoris pour épingler jusqu\'à 6 apps indispensables.</string>
    <string name="tutorial_slide_3_title">profils contextuels</string>
    <string name="tutorial_slide_3_desc">basculez de profil (normal, travail ou detox) depuis le menu latéral pour contrôler les apps visibles et filtrer les distractions.</string>
    <string name="tutorial_slide_4_title">bloquer les distractions</string>
    <string name="tutorial_slide_4_desc">dans la liste de toutes les applications, maintenez une app pour bloquer son accès en mode travail ou detox.</string>
    <string name="tutorial_slide_5_title">renommer &amp; personnaliser</string>
    <string name="tutorial_slide_5_desc">maintenez n\'importe quelle app dans le tiroir d\'applications pour la renommer en un nom propre, épuré et sans marque.</string>
    <string name="tutorial_slide_6_title">mode detox absolu</string>
    <string name="tutorial_slide_6_desc">lancez une session detox avec durée personnalisée et mot de passe obligatoire pour éviter de désactiver le mode trop tôt.</string>
    <string name="tutorial_slide_7_title">pause consciente</string>
    <string name="tutorial_slide_7_desc">ajoutez un timer de respiration avant d\'ouvrir les applications sélectionnées pour réfléchir avant de vous laisser distraire.</string>
    <string name="tutorial_slide_8_title">horloge &amp; personnalisation</string>
    <string name="tutorial_slide_8_desc">personnalisez le style et la taille de l\'horloge, alignez le texte et décidez d\'afficher ou de masquer la barre de statut supérieure.</string>
