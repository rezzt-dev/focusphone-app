<?xml version="1.0" encoding="utf-8"?>
<!-- Music tile: the artwork is the tile, with play / pause and the track (2 x 2). RemoteViews ignore app:tint, so android:tint is right here. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/wg_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="UseAppTint">

    <ImageView
        android:id="@+id/wg_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/wg_bg_squircle"
        android:tint="@color/wg_preview_card" />

    <ImageView
        android:id="@+id/wg_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:id="@+id/wg_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/wg_play"
            android:layout_width="@dimen/wg_button_large"
            android:layout_height="@dimen/wg_button_large"
            android:contentDescription="@string/wg_cd_play"
            android:layout_gravity="center">

            <ImageView
                android:id="@+id/wg_play_fill"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/wg_bg_dot"
                android:tint="@color/wg_preview_accent" />

            <ImageView
                android:id="@+id/wg_play_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_wg_play"
                android:tint="@color/wg_preview_on_accent" />
        </FrameLayout>
        <TextView
            android:id="@+id/wg_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:maxWidth="132dp"
            android:gravity="center"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="@string/wg_preview_title"
            android:textColor="@color/wg_preview_text"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/wg_artist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxWidth="132dp"
            android:gravity="center"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/wg_preview_artist"
            android:textColor="@color/wg_preview_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

</FrameLayout>
