<?xml version="1.0" encoding="utf-8"?>
<!-- Item in the "all installed apps" list with icon + name + checkbox -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="60dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/spacing_xl"
    android:paddingTop="@dimen/spacing_l"
    android:paddingEnd="@dimen/spacing_l"
    android:paddingBottom="@dimen/spacing_l">

    <!-- App icon (hidden for minimalist aesthetic) -->
    <ImageView
        android:id="@+id/iv_app_icon"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:visibility="gone" />

    <!-- App name: regular weight for legibility -->
    <TextView
        android:id="@+id/tv_app_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="0dp"
        android:layout_weight="1"
        android:fontFamily="sans-serif-light"
        android:letterSpacing="0.02"
        android:textColor="?attr/android:textColorPrimary"
        android:textSize="17sp"
        tools:text="messages" />

    <!-- Favourite toggle text indicator -->
    <TextView
        android:id="@+id/tv_select_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:fontFamily="sans-serif-light"
        android:textSize="18sp"
        android:textColor="?attr/android:textColorPrimary"
        tools:text="+" />

</LinearLayout>
