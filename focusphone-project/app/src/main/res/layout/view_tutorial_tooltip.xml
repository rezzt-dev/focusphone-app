<?xml version="1.0" encoding="utf-8"?>
<!--
  Tooltip shown during the interactive contextual tutorial.
  Positioned dynamically by TutorialOverlayView near the highlighted element.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tooltip_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_tutorial_tooltip"
    android:elevation="8dp"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tv_tooltip_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:letterSpacing="0.02"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="17sp"
        tools:text="your calm home" />

    <TextView
        android:id="@+id/tv_tooltip_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="sans-serif-light"
        android:gravity="center"
        android:letterSpacing="0.01"
        android:lineSpacingMultiplier="1.3"
        android:maxWidth="280dp"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="14sp"
        tools:text="this is your new home. just the time, the date, and your chosen apps." />

    <TextView
        android:id="@+id/btn_tooltip_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="?attr/selectableItemBackground"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:letterSpacing="0.08"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:text="@string/tutorial_coach_got_it"
        android:textAllCaps="false"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="14sp" />

</LinearLayout>
