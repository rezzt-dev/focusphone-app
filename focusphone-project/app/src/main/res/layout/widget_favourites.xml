<?xml version="1.0" encoding="utf-8"?>
<!-- Favourites: favourite apps as text, like the home screen (2 x 2, resizable). RemoteViews ignore app:tint, so android:tint is right here. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/wg_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="UseAppTint">

    <ImageView
        android:id="@+id/wg_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/wg_bg_card"
        android:tint="@color/wg_preview_card" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="@dimen/wg_padding"
        android:paddingEnd="@dimen/wg_padding"
        android:paddingBottom="@dimen/wg_padding_compact">

        <TextView
            android:id="@+id/wg_fav_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:letterSpacing="0.06"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/wg_favourites_header"
            android:textColor="@color/wg_preview_text_tertiary"
            android:textSize="11sp" />
        <TextView
            android:id="@+id/wg_fav_0"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:gravity="center_vertical"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/wg_preview_fav_1"
            android:textColor="@color/wg_preview_text"
            android:textSize="19sp" />
        <TextView
            android:id="@+id/wg_fav_1"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:gravity="center_vertical"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/wg_preview_fav_2"
            android:textColor="@color/wg_preview_text"
            android:textSize="19sp" />
        <TextView
            android:id="@+id/wg_fav_2"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:gravity="center_vertical"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/wg_preview_fav_3"
            android:textColor="@color/wg_preview_text"
            android:textSize="19sp" />
        <TextView
            android:id="@+id/wg_fav_3"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:gravity="center_vertical"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/wg_preview_fav_4"
            android:textColor="@color/wg_preview_text"
            android:textSize="19sp" />
        <TextView
            android:id="@+id/wg_fav_4"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:gravity="center_vertical"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/wg_preview_fav_5"
            android:textColor="@color/wg_preview_text"
            android:textSize="19sp" />
        <TextView
            android:id="@+id/wg_fav_5"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:gravity="center_vertical"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/wg_preview_text"
            android:textSize="19sp" />
        <TextView
            android:id="@+id/wg_fav_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:visibility="gone"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="3"
            android:ellipsize="end"
            android:text="@string/wg_favourites_empty"
            android:textColor="@color/wg_preview_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

</FrameLayout>
