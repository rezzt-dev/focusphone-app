<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_input"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Title -->
    <TextView
        android:id="@+id/tv_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/theme_select_title"
        android:textColor="?attr/android:textColorPrimary"
        android:textSize="20sp"
        android:letterSpacing="0.02" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/android:textColorSecondary"
        android:alpha="0.15"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp" />

    <!-- Option: Off-White -->
    <LinearLayout
        android:id="@+id/btn_theme_off_white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <View
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_theme_card_off_white"
            android:layout_marginEnd="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:text="@string/settings_theme_off_white"
            android:textColor="?attr/android:textColorPrimary"
            android:textSize="17sp" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/android:textColorSecondary"
        android:alpha="0.1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp" />

    <!-- Option: Slate -->
    <LinearLayout
        android:id="@+id/btn_theme_slate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <View
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_theme_card_slate"
            android:layout_marginEnd="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:text="@string/settings_theme_slate"
            android:textColor="?attr/android:textColorPrimary"
            android:textSize="17sp" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/android:textColorSecondary"
        android:alpha="0.1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp" />

    <!-- Option: Warm Beige -->
    <LinearLayout
        android:id="@+id/btn_theme_warm_beige"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <View
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_theme_card_warm_beige"
            android:layout_marginEnd="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:text="@string/settings_theme_warm_beige"
            android:textColor="?attr/android:textColorPrimary"
            android:textSize="17sp" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/android:textColorSecondary"
        android:alpha="0.1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp" />

    <!-- Option: Navy -->
    <LinearLayout
        android:id="@+id/btn_theme_navy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <View
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_theme_card_navy"
            android:layout_marginEnd="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:text="@string/settings_theme_navy"
            android:textColor="?attr/android:textColorPrimary"
            android:textSize="17sp" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/android:textColorSecondary"
        android:alpha="0.1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp" />

    <!-- Option: Auto -->
    <LinearLayout
        android:id="@+id/btn_theme_auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <View
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_theme_card_slate"
            android:layout_marginEnd="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:text="@string/settings_theme_auto"
            android:textColor="?attr/android:textColorPrimary"
            android:textSize="17sp" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/android:textColorSecondary"
        android:alpha="0.1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp" />

    <!-- Option: Custom -->
    <LinearLayout
        android:id="@+id/btn_theme_custom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <View
            android:id="@+id/view_theme_custom_circle_dialog"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_theme_card_slate"
            android:layout_marginEnd="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:text="@string/settings_theme_custom"
            android:textColor="?attr/android:textColorPrimary"
            android:textSize="17sp" />
    </LinearLayout>

</LinearLayout>
