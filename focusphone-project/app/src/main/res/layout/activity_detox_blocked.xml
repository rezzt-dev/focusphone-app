<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:colorBackground"
    android:keepScreenOn="true">

    <!-- ── Center Detox Circle ────────────────────────────────── -->
    <FrameLayout
        android:id="@+id/view_detox_circle"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:background="@drawable/shape_breathing_circle"
        app:layout_constraintBottom_toTopOf="@id/tv_detox_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed">

        <!-- Countdown Container -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_detox_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:includeFontPadding="false"
                android:textColor="?attr/android:textColorPrimary"
                android:textSize="38sp"
                tools:text="14:59" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.12"
                android:text="detox"
                android:textColor="?attr/android:textColorSecondary"
                android:textSize="11dp"
                android:textAllCaps="true" />

        </LinearLayout>

    </FrameLayout>

    <!-- ── Detox Title ────────────────────────────────────────── -->
    <TextView
        android:id="@+id/tv_detox_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:fontFamily="sans-serif"
        android:letterSpacing="0.04"
        android:text="@string/detox_blocked_title"
        android:textColor="?attr/android:textColorPrimary"
        android:textSize="22sp"
        app:layout_constraintBottom_toTopOf="@id/tv_detox_desc"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/view_detox_circle" />

    <!-- ── Detox Description ──────────────────────────────────── -->
    <TextView
        android:id="@+id/tv_detox_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="44dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="44dp"
        android:fontFamily="sans-serif-light"
        android:gravity="center"
        android:lineSpacingMultiplier="1.3"
        android:text="@string/detox_blocked_desc"
        android:textColor="?attr/android:textColorSecondary"
        android:textSize="15sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_detox_title" />

</androidx.constraintlayout.widget.ConstraintLayout>
