<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/clock_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ── TYPE 1: Digital (HH:mm + date) ─────────────────── -->
    <LinearLayout
        android:id="@+id/clock_type_digital"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:letterSpacing="-0.03"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="56sp"
            tools:text="09:41" />

        <TextView
            android:id="@+id/tv_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.04"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="16sp"
            tools:text="Tuesday, 5 May" />
    </LinearLayout>

    <!-- ── TYPE 2: Stacked (hours / minutes on separate lines) -->
    <LinearLayout
        android:id="@+id/clock_type_stacked"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_stacked_h"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:letterSpacing="-0.04"
            android:lineSpacingMultiplier="0.85"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="76sp"
            tools:text="09" />

        <TextView
            android:id="@+id/tv_stacked_m"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:letterSpacing="-0.04"
            android:lineSpacingMultiplier="0.85"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="76sp"
            tools:text="41" />

        <TextView
            android:id="@+id/tv_stacked_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.04"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="16sp"
            tools:text="Tuesday, 5 May" />
    </LinearLayout>

    <!-- ── TYPE 3: Words ───────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/clock_type_words"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="44dp"
        android:paddingEnd="44dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_words_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:lineSpacingMultiplier="1.1"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="34sp"
            tools:text="nine\nforty-one" />

        <TextView
            android:id="@+id/tv_words_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.04"
            android:gravity="center"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="16sp"
            tools:text="tuesday, 5 may" />
    </LinearLayout>

    <!-- ── TYPE 4: Analog ──────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/clock_type_analog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <app.focusphone.ui.widget.AnalogClockView
            android:id="@+id/view_analog"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginStart="52dp"
            android:layout_marginEnd="52dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:contentDescription="@string/cd_analog_clock" />

        <TextView
            android:id="@+id/tv_analog_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.04"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="16sp"
            tools:text="Tuesday, 5 May" />
    </LinearLayout>

    <!-- ── TYPE 5: Hidden / None ───────────────────────────── -->
    <TextView
        android:id="@+id/clock_type_none"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:fontFamily="sans-serif"
        android:letterSpacing="0.04"
        android:text="none"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="24sp"
        android:visibility="gone" />

</FrameLayout>
