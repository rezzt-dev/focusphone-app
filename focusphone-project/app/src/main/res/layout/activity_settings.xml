<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:colorBackground">

    <!-- ── Toolbar ─────────────────────────────────────────────── -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="@string/cd_back_button"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:minWidth="64dp"
            android:minHeight="48dp"
            android:paddingStart="20dp"
            android:paddingEnd="12dp"
            android:text="@string/settings_back"
            android:textColor="?attr/android:textColorSecondary"
            android:textSize="15sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.04"
            android:text="@string/settings_title"
            android:textColor="?attr/android:textColorPrimary"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/divider_toolbar"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:alpha="0.12"
        android:background="?attr/android:textColorPrimary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <!-- ── Scrollable content ──────────────────────────────────── -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:overScrollMode="never"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divider_toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="56dp">

            <!-- ═══ APPEARANCE ══════════════════════════════════════ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:letterSpacing="0.14"
                android:paddingStart="24dp"
                android:paddingTop="32dp"
                android:paddingEnd="24dp"
                android:paddingBottom="12dp"
                android:text="@string/settings_section_appearance"
                android:textAllCaps="true"
                android:textColor="?attr/android:textColorSecondary"
                android:textSize="11sp" />

            <!-- 2×2 Theme grid — each card previews how the home screen looks -->
            <GridLayout
                android:id="@+id/theme_selector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="4dp">

                <FrameLayout android:id="@+id/card_theme_off_white"
                    android:layout_width="0dp" android:layout_height="130dp"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="6dp" android:layout_marginBottom="6dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:background="@drawable/bg_theme_card_off_white"
                        android:gravity="center" android:orientation="vertical"
                        android:paddingStart="18dp" android:paddingEnd="18dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="09:41" android:textColor="#333333" android:textSize="22sp"
                            android:fontFamily="sans-serif" android:includeFontPadding="false" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="8dp" android:text="messages\nphotos\nnotes"
                            android:textColor="#555555" android:textSize="11sp"
                            android:fontFamily="sans-serif-medium" android:lineSpacingMultiplier="1.3" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="8dp"
                        android:text="@string/settings_theme_off_white" android:textColor="#888888"
                        android:textSize="10sp" android:fontFamily="sans-serif" android:letterSpacing="0.06" />
                </FrameLayout>

                <FrameLayout android:id="@+id/card_theme_slate"
                    android:layout_width="0dp" android:layout_height="130dp"
                    android:layout_columnWeight="1"
                    android:layout_marginBottom="6dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:background="@drawable/bg_theme_card_slate"
                        android:gravity="center" android:orientation="vertical"
                        android:paddingStart="18dp" android:paddingEnd="18dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="09:41" android:textColor="#E0E0E0" android:textSize="22sp"
                            android:fontFamily="sans-serif" android:includeFontPadding="false" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="8dp" android:text="messages\nphotos\nnotes"
                            android:textColor="#9E9E9E" android:textSize="11sp"
                            android:fontFamily="sans-serif-medium" android:lineSpacingMultiplier="1.3" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="8dp"
                        android:text="@string/settings_theme_slate" android:textColor="#666666"
                        android:textSize="10sp" android:fontFamily="sans-serif" android:letterSpacing="0.06" />
                </FrameLayout>

                <FrameLayout android:id="@+id/card_theme_warm_beige"
                    android:layout_width="0dp" android:layout_height="130dp"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="6dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:background="@drawable/bg_theme_card_warm_beige"
                        android:gravity="center" android:orientation="vertical"
                        android:paddingStart="18dp" android:paddingEnd="18dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="09:41" android:textColor="#4A4A4A" android:textSize="22sp"
                            android:fontFamily="sans-serif" android:includeFontPadding="false" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="8dp" android:text="messages\nphotos\nnotes"
                            android:textColor="#8A8078" android:textSize="11sp"
                            android:fontFamily="sans-serif-medium" android:lineSpacingMultiplier="1.3" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="8dp"
                        android:text="@string/settings_theme_warm_beige" android:textColor="#A09080"
                        android:textSize="10sp" android:fontFamily="sans-serif" android:letterSpacing="0.06" />
                </FrameLayout>

                <FrameLayout android:id="@+id/card_theme_navy"
                    android:layout_width="0dp" android:layout_height="130dp"
                    android:layout_columnWeight="1">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:background="@drawable/bg_theme_card_navy"
                        android:gravity="center" android:orientation="vertical"
                        android:paddingStart="18dp" android:paddingEnd="18dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="09:41" android:textColor="#E2E8F0" android:textSize="22sp"
                            android:fontFamily="sans-serif" android:includeFontPadding="false" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="8dp" android:text="messages\nphotos\nnotes"
                            android:textColor="#94A3B8" android:textSize="11sp"
                            android:fontFamily="sans-serif-medium" android:lineSpacingMultiplier="1.3" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="8dp"
                        android:text="@string/settings_theme_navy" android:textColor="#6B7B90"
                        android:textSize="10sp" android:fontFamily="sans-serif" android:letterSpacing="0.06" />
                </FrameLayout>

            </GridLayout>

            <!-- Text Alignment -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_alignment"
                    android:textColor="?attr/android:textColorSecondary"
                    android:textAllCaps="true"
                    android:letterSpacing="0.14"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif" />

                <!-- Segmented Control Container -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_segmented_control"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/btn_align_left"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="72dp"
                        android:gravity="center"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:text="@string/settings_alignment_left"
                        android:textColor="@color/color_segmented_text"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:background="@drawable/bg_segmented_item" />

                    <TextView
                        android:id="@+id/btn_align_center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="72dp"
                        android:gravity="center"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:text="@string/settings_alignment_center"
                        android:textColor="@color/color_segmented_text"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:background="@drawable/bg_segmented_item" />

                    <TextView
                        android:id="@+id/btn_align_right"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="72dp"
                        android:gravity="center"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:text="@string/settings_alignment_right"
                        android:textColor="@color/color_segmented_text"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:background="@drawable/bg_segmented_item" />
                </LinearLayout>
            </LinearLayout>

            <!-- Status Bar Toggle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_hide_status_bar"
                        android:textColor="?attr/android:textColorPrimary"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/settings_hide_status_bar_desc"
                        android:textColor="?attr/android:textColorSecondary"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_hide_status_bar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Section divider -->
            <View android:layout_width="match_parent" android:layout_height="0.5dp"
                android:layout_marginStart="24dp" android:layout_marginEnd="24dp"
                android:layout_marginTop="20dp" android:layout_marginBottom="0dp"
                android:alpha="0.12" android:background="?attr/android:textColorPrimary" />

            <!-- ═══ CLOCK TYPE ══════════════════════════════════════ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:letterSpacing="0.14"
                android:paddingStart="24dp"
                android:paddingTop="28dp"
                android:paddingEnd="24dp"
                android:paddingBottom="12dp"
                android:text="@string/settings_section_clock"
                android:textAllCaps="true"
                android:textColor="?attr/android:textColorSecondary"
                android:textSize="11sp" />

            <!-- Clock type tiles: inflated programmatically into this container -->
            <LinearLayout
                android:id="@+id/clock_type_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="4dp" />

            <!-- Clock Size Slider -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:letterSpacing="0.14"
                android:paddingStart="24dp"
                android:paddingTop="16dp"
                android:paddingEnd="24dp"
                android:paddingBottom="4dp"
                android:text="@string/settings_clock_size"
                android:textAllCaps="true"
                android:textColor="?attr/android:textColorSecondary"
                android:textSize="11sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/slider_clock_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:valueFrom="0.0"
                android:valueTo="100.0"
                android:stepSize="1.0"
                app:thumbColor="?attr/android:textColorPrimary"
                app:trackColorActive="?attr/android:textColorPrimary"
                app:trackColorInactive="?attr/android:textColorSecondary" />

            <View android:layout_width="match_parent" android:layout_height="0.5dp"
                android:layout_marginStart="24dp" android:layout_marginEnd="24dp"
                android:layout_marginTop="20dp"
                android:alpha="0.12" android:background="?attr/android:textColorPrimary" />


            <!-- ═══ LANGUAGE ═══════════════════════════════════════ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:letterSpacing="0.14"
                android:paddingStart="24dp"
                android:paddingTop="28dp"
                android:paddingEnd="24dp"
                android:paddingBottom="8dp"
                android:text="@string/settings_section_language"
                android:textAllCaps="true"
                android:textColor="?attr/android:textColorSecondary"
                android:textSize="11sp" />

            <!-- Language items: inflated programmatically -->
            <LinearLayout
                android:id="@+id/language_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp" />

            <View android:layout_width="match_parent" android:layout_height="0.5dp"
                android:layout_marginStart="24dp" android:layout_marginEnd="24dp"
                android:layout_marginTop="20dp"
                android:alpha="0.12" android:background="?attr/android:textColorPrimary" />

            <!-- ═══ LAUNCHER ════════════════════════════════════════ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:letterSpacing="0.14"
                android:paddingStart="24dp"
                android:paddingTop="28dp"
                android:paddingEnd="24dp"
                android:paddingBottom="4dp"
                android:text="@string/settings_section_launcher"
                android:textAllCaps="true"
                android:textColor="?attr/android:textColorSecondary"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/item_set_default_launcher"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingStart="24dp"
                android:paddingTop="12dp"
                android:paddingEnd="24dp"
                android:paddingBottom="12dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="sans-serif" android:textSize="16sp"
                        android:textColor="?attr/android:textColorPrimary"
                        android:text="@string/settings_set_default" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="sans-serif" android:textSize="13sp"
                        android:layout_marginTop="2dp"
                        android:textColor="?attr/android:textColorSecondary"
                        android:text="@string/settings_set_default_desc" />
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:textColor="?attr/android:textColorSecondary"
                    android:textSize="20sp"
                    android:text="›" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="0.5dp"
                android:layout_marginStart="24dp" android:layout_marginEnd="24dp"
                android:alpha="0.12" android:background="?attr/android:textColorPrimary" />

            <!-- ═══ ABOUT ════════════════════════════════════════════ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:letterSpacing="0.14"
                android:paddingStart="24dp"
                android:paddingTop="28dp"
                android:paddingEnd="24dp"
                android:paddingBottom="4dp"
                android:text="@string/settings_section_about"
                android:textAllCaps="true"
                android:textColor="?attr/android:textColorSecondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:paddingStart="24dp"
                android:paddingTop="12dp"
                android:paddingEnd="24dp"
                android:paddingBottom="16dp"
                android:textColor="?attr/android:textColorSecondary"
                android:textSize="14sp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
