<?xml version="1.0" encoding="utf-8"?>
<!-- Clock: large time, the date and the next alarm (4 x 2). RemoteViews ignore app:tint, so android:tint is right here. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/wg_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="UseAppTint">

    <ImageView
        android:id="@+id/wg_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/wg_bg_card"
        android:tint="@color/wg_preview_card" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="@dimen/wg_padding">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextClock
                android:id="@+id/wg_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:format12Hour="@string/wg_format_time_12"
                android:format24Hour="@string/wg_format_time_24"
                android:includeFontPadding="false"
                android:letterSpacing="-0.02"
                android:maxLines="1"
                android:textColor="@color/wg_preview_text"
                android:textSize="58sp" />

            <TextClock
                android:id="@+id/wg_ampm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif"
                android:format12Hour="@string/wg_format_ampm"
                android:format24Hour="@string/wg_format_none"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/wg_preview_text_secondary"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/wg_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/wg_preview_date"
                android:textColor="@color/wg_preview_text_secondary"
                android:textSize="14sp" />
            <ImageView
                android:id="@+id/wg_alarm_icon"
                android:layout_width="@dimen/wg_icon_small"
                android:layout_height="@dimen/wg_icon_small"
                android:layout_marginStart="12dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_wg_alarm_clock"
                android:tint="@color/wg_preview_text_secondary" />
            <TextView
                android:id="@+id/wg_alarm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/wg_preview_alarm_time"
                android:textColor="@color/wg_preview_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
