<?xml version="1.0" encoding="utf-8"?>
<!-- Next alarm: when the next alarm rings (2 x 1). RemoteViews ignore app:tint, so android:tint is right here. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/wg_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="UseAppTint">

    <ImageView
        android:id="@+id/wg_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/wg_bg_card"
        android:tint="@color/wg_preview_card" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="@dimen/wg_padding"
        android:paddingEnd="@dimen/wg_padding">

        <FrameLayout
            android:id="@+id/wg_badge"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center">

            <ImageView
                android:id="@+id/wg_badge_fill"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/wg_bg_dot"
                android:tint="@color/wg_preview_chip" />

            <ImageView
                android:id="@+id/wg_badge_icon"
                android:layout_width="@dimen/wg_icon"
                android:layout_height="@dimen/wg_icon"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_wg_alarm_clock"
                android:tint="@color/wg_preview_text" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/wg_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/wg_preview_alarm_time"
                android:textColor="@color/wg_preview_text"
                android:textSize="22sp" />
            <TextView
                android:id="@+id/wg_caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/wg_preview_alarm_day"
                android:textColor="@color/wg_preview_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
