<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:colorBackground">

    <androidx.drawerlayout.widget.DrawerLayout
        android:id="@+id/drawer_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <!-- MAIN CONTENT -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/root_home"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!--
            CLOCK CONTAINER — fills top 38% of screen.
            Only one clock_type_* child is visible at a time.
            Top padding applied via insets in HomeActivity.setupInsets()
        -->
        <FrameLayout
            android:id="@+id/clock_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@id/guideline_top"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- ── TYPE 1: Digital (HH:mm + date) ─────────────────── -->
            <LinearLayout
                android:id="@+id/clock_type_digital"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.03"
                    android:textColor="?attr/android:textColorPrimary"
                    android:textSize="56sp"
                    tools:text="09:41" />

                <TextView
                    android:id="@+id/tv_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif"
                    android:letterSpacing="0.04"
                    android:textColor="?attr/android:textColorSecondary"
                    android:textSize="16sp"
                    tools:text="Tuesday, 5 May" />
            </LinearLayout>

            <!-- ── TYPE 2: Stacked (hours / minutes on separate lines) -->
            <LinearLayout
                android:id="@+id/clock_type_stacked"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_stacked_h"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.04"
                    android:lineSpacingMultiplier="0.85"
                    android:textColor="?attr/android:textColorPrimary"
                    android:textSize="76sp"
                    tools:text="09" />

                <TextView
                    android:id="@+id/tv_stacked_m"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.04"
                    android:lineSpacingMultiplier="0.85"
                    android:textColor="?attr/android:textColorPrimary"
                    android:textSize="76sp"
                    tools:text="41" />

                <TextView
                    android:id="@+id/tv_stacked_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif"
                    android:letterSpacing="0.04"
                    android:textColor="?attr/android:textColorSecondary"
                    android:textSize="16sp"
                    tools:text="Tuesday, 5 May" />
            </LinearLayout>

            <!-- ── TYPE 3: Words ───────────────────────────────────── -->
            <LinearLayout
                android:id="@+id/clock_type_words"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="44dp"
                android:paddingEnd="44dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_words_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.1"
                    android:textColor="?attr/android:textColorPrimary"
                    android:textSize="34sp"
                    tools:text="nine\nforty-one" />

                <TextView
                    android:id="@+id/tv_words_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="sans-serif"
                    android:letterSpacing="0.04"
                    android:gravity="center"
                    android:textColor="?attr/android:textColorSecondary"
                    android:textSize="16sp"
                    tools:text="tuesday, 5 may" />
            </LinearLayout>

            <!-- ── TYPE 4: Analog ──────────────────────────────────── -->
            <LinearLayout
                android:id="@+id/clock_type_analog"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <app.focusphone.ui.widget.AnalogClockView
                    android:id="@+id/view_analog"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="52dp"
                    android:layout_marginEnd="52dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tv_analog_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="sans-serif"
                    android:letterSpacing="0.04"
                    android:textColor="?attr/android:textColorSecondary"
                    android:textSize="16sp"
                    tools:text="Tuesday, 5 May" />
            </LinearLayout>

        </FrameLayout>

        <!-- Guideline at 38% ──────────────────────────────────────────── -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.38" />

        <!-- App container ──────────────────────────────────────────────── -->
        <FrameLayout
            android:id="@+id/apps_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:paddingTop="48dp"
            android:paddingBottom="48dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/guideline_top">

            <!-- App list -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_favourite_apps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:clipToPadding="false"
                android:overScrollMode="never"
                tools:listitem="@layout/item_favourite_app" />

            <!-- Empty state -->
            <TextView
                android:id="@+id/tv_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:fontFamily="sans-serif"
                android:gravity="start"
                android:lineSpacingMultiplier="1.7"
                android:paddingStart="44dp"
                android:paddingEnd="44dp"
                android:paddingTop="24dp"
                android:text="@string/home_no_apps"
                android:textColor="?attr/android:textColorSecondary"
                android:textSize="22sp"
                android:visibility="gone" />

        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- DRAWER CONTENT -->
    <LinearLayout
        android:id="@+id/drawer_menu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="?attr/android:colorBackground"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:id="@+id/tv_menu_all_apps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/home_all_apps"
            android:textColor="?attr/android:textColorPrimary"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/tv_menu_select_apps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="?attr/selectableItemBackground"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/home_edit_apps"
            android:textColor="?attr/android:textColorPrimary"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/tv_menu_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="?attr/selectableItemBackground"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/home_settings"
            android:textColor="?attr/android:textColorPrimary"
            android:textSize="28sp" />

    </LinearLayout>

    </androidx.drawerlayout.widget.DrawerLayout>

    <!-- Page indicators -->
    <LinearLayout
        android:id="@+id/indicator_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="horizontal"
        android:layout_marginBottom="48dp"
        android:padding="8dp">

        <View
            android:id="@+id/indicator_home"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/shape_indicator_filled" />

        <View
            android:id="@+id/indicator_menu"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/shape_indicator_outline" />
    </LinearLayout>

</FrameLayout>
