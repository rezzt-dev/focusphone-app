<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Wallpaper behind the whole home screen (including open drawers) -->
    <ImageView
        android:id="@+id/iv_wallpaper_home"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <androidx.drawerlayout.widget.DrawerLayout
        android:id="@+id/drawer_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <!-- MAIN CONTENT -->
    <FrameLayout
        android:id="@+id/home_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent">

    <!--
        Home legibility scrim. Sits above the wallpaper and below the clock and app list,
        and is NOT translated with the content when a drawer slides, so the dimming stays
        anchored to the screen. Driven by HomeActivity.applyScrim().
    -->
    <View
        android:id="@+id/view_scrim_home"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/root_home"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@android:color/transparent"
        android:gravity="center_vertical">

        <!--
            CLOCK CONTAINER — fills top 38% of screen.
            Only one clock_type_* child is visible at a time.
            Top padding applied via insets in HomeActivity.setupInsets()
        -->
        <FrameLayout
            android:id="@+id/clock_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp">

            <!-- ── TYPE 1: Digital (HH:mm + date) ─────────────────── -->
            <LinearLayout
                android:id="@+id/clock_type_digital"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.03"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="56sp"
                    tools:text="09:41" />

                <TextView
                    android:id="@+id/tv_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif"
                    android:letterSpacing="0.04"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="16sp"
                    tools:text="Tuesday, 5 May" />
            </LinearLayout>

            <!-- ── TYPE 2: Stacked (hours / minutes on separate lines) -->
            <LinearLayout
                android:id="@+id/clock_type_stacked"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_stacked_h"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.04"
                    android:lineSpacingMultiplier="0.85"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="76sp"
                    tools:text="09" />

                <TextView
                    android:id="@+id/tv_stacked_m"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.04"
                    android:lineSpacingMultiplier="0.85"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="76sp"
                    tools:text="41" />

                <TextView
                    android:id="@+id/tv_stacked_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif"
                    android:letterSpacing="0.04"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="16sp"
                    tools:text="Tuesday, 5 May" />
            </LinearLayout>

            <!-- ── TYPE 3: Words ───────────────────────────────────── -->
            <LinearLayout
                android:id="@+id/clock_type_words"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="44dp"
                android:paddingEnd="44dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_words_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.1"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="34sp"
                    tools:text="nine\nforty-one" />

                <TextView
                    android:id="@+id/tv_words_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="sans-serif"
                    android:letterSpacing="0.04"
                    android:gravity="center"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="16sp"
                    tools:text="tuesday, 5 may" />
            </LinearLayout>

            <!-- ── TYPE 4: Analog ──────────────────────────────────── -->
            <LinearLayout
                android:id="@+id/clock_type_analog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <app.focusphone.ui.widget.AnalogClockView
                    android:id="@+id/view_analog"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:layout_marginStart="52dp"
                    android:layout_marginEnd="52dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="4dp"
                    android:contentDescription="@string/cd_analog_clock" />

                <TextView
                    android:id="@+id/tv_analog_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="sans-serif"
                    android:letterSpacing="0.04"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="16sp"
                    tools:text="Tuesday, 5 May" />
            </LinearLayout>

        </FrameLayout>

        <!-- Widget container ───────────────────────────────────────────── -->
        <FrameLayout
            android:id="@+id/widget_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:visibility="gone" />

        <!-- App container ──────────────────────────────────────────────── -->
        <FrameLayout
            android:id="@+id/apps_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <!-- App list -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_favourite_apps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:clipToPadding="false"
                android:overScrollMode="never"
                tools:listitem="@layout/item_favourite_app" />

            <!-- Empty state -->
            <TextView
                android:id="@+id/tv_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:fontFamily="sans-serif"
                android:gravity="start"
                android:lineSpacingMultiplier="1.7"
                android:paddingStart="44dp"
                android:paddingEnd="44dp"
                android:paddingTop="24dp"
                android:text="@string/home_no_apps"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="22sp"
                android:visibility="gone" />

        </FrameLayout>

    </LinearLayout>

    </FrameLayout>

    <!-- DRAWER CONTENT -->
    <FrameLayout
        android:id="@+id/drawer_menu"
        android:layout_width="@dimen/drawer_width"
        android:layout_height="match_parent"
        android:layout_gravity="end">

        <!--
            Panel scrim behind the calendar and launcher options. Colour and alpha come from
            the active palette and the user's legibility preference; hidden entirely when no
            wallpaper is showing.
        -->
        <View
            android:id="@+id/view_scrim_menu"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/menu_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp">

        <!-- TOP HALF: Minimalist Calendar -->
        <LinearLayout
            android:id="@+id/layout_calendar_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="12dp">

            <!-- Month Title (e.g., "mayo 2026") -->
            <TextView
                android:id="@+id/tv_calendar_month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="20sp"
                android:letterSpacing="0.05"
                android:layout_marginBottom="16dp"
                tools:text="mayo 2026" />

            <!-- Weekdays header (L, M, M, J, V, S, D) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="7"
                android:layout_marginBottom="12dp">

                <TextView android:id="@+id/tv_day_0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="" tools:text="m" android:textColor="?android:attr/textColorSecondary" android:textSize="13sp" android:fontFamily="sans-serif-medium" />
                <TextView android:id="@+id/tv_day_1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="" tools:text="t" android:textColor="?android:attr/textColorSecondary" android:textSize="13sp" android:fontFamily="sans-serif-medium" />
                <TextView android:id="@+id/tv_day_2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="" tools:text="w" android:textColor="?android:attr/textColorSecondary" android:textSize="13sp" android:fontFamily="sans-serif-medium" />
                <TextView android:id="@+id/tv_day_3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="" tools:text="t" android:textColor="?android:attr/textColorSecondary" android:textSize="13sp" android:fontFamily="sans-serif-medium" />
                <TextView android:id="@+id/tv_day_4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="" tools:text="f" android:textColor="?android:attr/textColorSecondary" android:textSize="13sp" android:fontFamily="sans-serif-medium" />
                <TextView android:id="@+id/tv_day_5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="" tools:text="s" android:textColor="?android:attr/textColorSecondary" android:textSize="13sp" android:fontFamily="sans-serif-medium" />
                <TextView android:id="@+id/tv_day_6" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="" tools:text="s" android:textColor="?android:attr/textColorSecondary" android:textSize="13sp" android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- Days Grid -->
            <LinearLayout
                android:id="@+id/calendar_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- BOTTOM HALF: Menu options -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="start|center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp">

            <!-- "ajustes de focusphone" -->
            <TextView
                android:id="@+id/tv_menu_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:fontFamily="sans-serif"
                android:gravity="start|center_vertical"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="@string/home_settings"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="26sp" />

            <!-- "todas las apps" -->
            <TextView
                android:id="@+id/tv_menu_all_apps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="?attr/selectableItemBackground"
                android:fontFamily="sans-serif"
                android:gravity="start|center_vertical"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="@string/home_all_apps"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="26sp" />

            <!-- "editar apps" -->
            <TextView
                android:id="@+id/tv_menu_select_apps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="?attr/selectableItemBackground"
                android:fontFamily="sans-serif"
                android:gravity="start|center_vertical"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="@string/home_edit_apps"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="26sp" />

            <!-- "perfil: libre" -->
            <TextView
                android:id="@+id/tv_menu_profile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="?attr/selectableItemBackground"
                android:fontFamily="sans-serif"
                android:gravity="start|center_vertical"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="26sp"
                tools:text="perfil: libre" />

        </LinearLayout>

        </LinearLayout>

    </FrameLayout>

    <!-- LEFT DRAWER: Notifications Panel -->
    <FrameLayout
        android:id="@+id/drawer_notifications"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@android:color/transparent">

        <!-- Wallpaper behind the notification drawer content -->
        <!-- Notification drawer intentionally has no dedicated wallpaper: it reuses the home
             wallpaper or the theme background so a per-screen image cannot render corrupted. -->
        <!-- Panel scrim so notifications and the empty state stay readable over the wallpaper -->
        <View
            android:id="@+id/view_scrim_notifications"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/notification_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp">

        <!-- Title -->
        <TextView
            android:id="@+id/tv_notifications_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:gravity="start|center_vertical"
            android:paddingTop="4dp"
            android:paddingBottom="10dp"
            android:ellipsize="none"
            android:maxLines="2"
            android:text="@string/notification_panel_title"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="26sp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:alpha="0.12"
            android:background="?android:attr/textColorPrimary" />

        <!-- Notification list -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_notifications"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingTop="8dp"
            tools:listitem="@layout/item_notification" />

        <!-- Empty state -->
        <TextView
            android:id="@+id/tv_notifications_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:text="@string/notification_empty"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="18sp"
            android:visibility="gone" />

        <!-- Clear all button -->
        <LinearLayout
            android:id="@+id/btn_clear_all_notifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            android:background="?attr/selectableItemBackground"
            android:visibility="gone">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_clear_all"
                android:contentDescription="@string/cd_clear_all"
                app:tint="?android:attr/textColorSecondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif"
                android:text="@string/notification_clear_all"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp" />

        </LinearLayout>

        </LinearLayout>

    </FrameLayout>

    </androidx.drawerlayout.widget.DrawerLayout>

    <!-- Page indicators -->
    <LinearLayout
        android:id="@+id/indicator_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp"
        android:padding="8dp"
        android:visibility="invisible">

        <View
            android:id="@+id/indicator_notifications"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/shape_indicator_outline" />

        <View
            android:id="@+id/indicator_home"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/shape_indicator_filled" />

        <View
            android:id="@+id/indicator_menu"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/shape_indicator_outline" />
    </LinearLayout>

</FrameLayout>
