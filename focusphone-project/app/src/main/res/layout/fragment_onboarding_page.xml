<?xml version="1.0" encoding="utf-8"?>
<!-- Single onboarding page: title + body + optional action button -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_xxl"
    android:paddingEnd="@dimen/spacing_xxl">

    <TextView
        android:id="@+id/tv_page_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-thin"
        android:gravity="start"
        android:letterSpacing="-0.01"
        android:lineSpacingMultiplier="1.1"
        android:textColor="?attr/android:textColorPrimary"
        android:textSize="@dimen/text_onboarding_title"
        tools:text="welcome." />

    <TextView
        android:id="@+id/tv_page_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_l"
        android:fontFamily="sans-serif-light"
        android:gravity="start"
        android:letterSpacing="0.02"
        android:lineSpacingMultiplier="1.6"
        android:textColor="?attr/android:textColorSecondary"
        android:textSize="@dimen/text_onboarding_body"
        tools:text="focusphone turns your Android into a distraction-free tool." />

    <TextView
        android:id="@+id/btn_page_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xxl"
        android:background="?attr/selectableItemBackground"
        android:fontFamily="sans-serif-light"
        android:letterSpacing="0.06"
        android:padding="@dimen/spacing_l"
        android:textAllCaps="false"
        android:textColor="?attr/android:textColorPrimary"
        android:textSize="15sp"
        android:visibility="gone"
        tools:text="Set as default" />

</LinearLayout>
