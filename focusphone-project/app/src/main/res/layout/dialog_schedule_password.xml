<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_input"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tv_schedule_password_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:fontFamily="sans-serif-medium"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="20sp"
        tools:text="protect schedules" />

    <TextView
        android:id="@+id/tv_schedule_password_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:fontFamily="sans-serif-light"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="14sp"
        tools:text="define a password to lock these settings" />

    <EditText
        android:id="@+id/et_schedule_password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:autofillHints="password"
        android:background="@android:color/transparent"
        android:hint="@string/detox_password_hint"
        android:inputType="textPassword"
        android:padding="12dp"
        android:textColor="?android:attr/textColorPrimary"
        android:textColorHint="?android:attr/textColorSecondary"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/et_schedule_password_confirm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:autofillHints="password"
        android:background="@android:color/transparent"
        android:hint="@string/schedule_password_confirm_hint"
        android:inputType="textPassword"
        android:padding="12dp"
        android:textColor="?android:attr/textColorPrimary"
        android:textColorHint="?android:attr/textColorSecondary"
        android:textSize="16sp"
        android:visibility="gone"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_schedule_password_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:fontFamily="sans-serif-light"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="13sp"
        android:visibility="gone"
        tools:text="incorrect password"
        tools:visibility="visible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:padding="12dp"
            android:text="@string/action_cancel"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btn_ok"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:padding="12dp"
            android:text="@string/action_save"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="15sp" />

    </LinearLayout>

</LinearLayout>
