    <!-- Enhanced Onboarding -->
    <string name="onboarding_step_welcome_title">bienvenido a focusphone.</string>
    <string name="onboarding_step_welcome_body">tu espacio digital, simplificado. creemos que tu teléfono debe servirte, no distraerte.</string>
    <string name="onboarding_step_welcome_tagline">menos ruido. más enfoque.</string>
    <string name="onboarding_step_philosophy_title">la idea es simple.</string>
    <string name="onboarding_step_philosophy_body">solo las apps que realmente necesitas. sin iconos pidiendo atención. sin desplazamientos infinitos. solo calma.</string>
    <string name="onboarding_step_launcher_title">establece como launcher predeterminado.</string>
    <string name="onboarding_step_launcher_body">para experimentar focusphone al completo, haz que sea tu pantalla de inicio. toca abajo para abrir los ajustes del sistema.</string>
    <string name="onboarding_step_launcher_action">abrir ajustes de launcher</string>
    <string name="onboarding_step_launcher_verified">launcher configurado correctamente.</string>
    <string name="onboarding_step_launcher_not_verified">aún no es el predeterminado.</string>
    <string name="onboarding_step_apps_title">elige tus esenciales.</string>
    <string name="onboarding_step_apps_body">selecciona hasta 10 apps que realmente importen. todo lo demás queda fuera de la vista, pero al alcance.</string>
    <string name="onboarding_step_apps_action">seleccionar apps</string>
    <string name="onboarding_step_profiles_title">perfiles para cada momento.</string>
    <string name="onboarding_step_profiles_body">normal para todo. trabajo para bloquear distracciones. detox para silencio digital completo.</string>
    <string name="onboarding_step_customize_title">hazlo tuyo.</string>
    <string name="onboarding_step_customize_body">elige un tema y un estilo de reloj que te representen. siempre puedes cambiarlo después.</string>
    <string name="onboarding_step_complete_title">estás listo.</string>
    <string name="onboarding_step_complete_body">te espera una pantalla de inicio tranquila y enfocada. recuerda: desliza a la izquierda para el menú, a la derecha para notificaciones.</string>
    <string name="onboarding_step_complete_action">entrar a focusphone</string>

    <!-- Tutorial Coach Marks -->
    <string name="tutorial_coach_home_title">tu hogar tranquilo</string>
    <string name="tutorial_coach_home_desc">esta es tu nueva pantalla de inicio. solo la hora, la fecha y tus apps elegidas. sin iconos, sin ruido.</string>
    <string name="tutorial_coach_menu_title">el menú</string>
    <string name="tutorial_coach_menu_desc">desliza a la izquierda para abrir el menú. desde aquí puedes acceder a todas las apps, ajustes y cambiar de perfil.</string>
    <string name="tutorial_coach_apps_title">añadir apps</string>
    <string name="tutorial_coach_apps_desc">toca \"editar dashboard\" en el menú para elegir hasta 10 apps. mantén pulsada una app para ver sus opciones, o arrástrala para reordenarla.</string>
    <string name="tutorial_coach_profile_title">perfiles contextuales</string>
    <string name="tutorial_coach_profile_desc">toca tu nombre de perfil para cambiar de modo. trabajo bloquea distracciones. detox bloquea todo.</string>
    <string name="tutorial_coach_block_title">bloquear apps</string>
    <string name="tutorial_coach_block_desc">en la lista de todas las apps, mantén pulsada cualquiera para bloquearla en modo trabajo o detox.</string>
    <string name="tutorial_coach_rename_title">renombrar apps</string>
    <string name="tutorial_coach_rename_desc">mantén pulsada cualquier app y elige renombrar para darle un nombre limpio y minimalista.</string>
    <string name="tutorial_coach_detox_title">modo detox</string>
    <string name="tutorial_coach_detox_desc">inicia una sesión detox cuando necesites enfoque total. establece una duración y una contraseña para mantener el compromiso.</string>
    <string name="tutorial_coach_customize_title">personalización profunda</string>
    <string name="tutorial_coach_customize_desc">explora los ajustes para cambiar temas, fuentes, estilos de reloj, alineación y mucho más.</string>
    <string name="tutorial_coach_got_it">entendido</string>

