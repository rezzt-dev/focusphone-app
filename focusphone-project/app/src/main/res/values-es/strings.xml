    <!-- Tutorial Slides -->
    <string name="tutorial_slide_1_title">minimalismo e inicio</string>
    <string name="tutorial_slide_1_desc">tu pantalla principal limpia, libre de distracciones e iconos ruidosos, optimizada para centrarte en lo importante.</string>
    <string name="tutorial_slide_2_title">fijar aplicaciones</string>
    <string name="tutorial_slide_2_desc">mantén presionado un espacio vacío en la pantalla de inicio o usa la selección de favoritos para fijar hasta 6 aplicaciones esenciales.</string>
    <string name="tutorial_slide_3_title">perfiles contextuales</string>
    <string name="tutorial_slide_3_desc">cambia de perfil (normal, trabajo o detox) desde el menú lateral para ajustar las aplicaciones visibles y bloquear distracciones.</string>
    <string name="tutorial_slide_4_title">bloquear aplicaciones</string>
    <string name="tutorial_slide_4_desc">en la lista de todas las aplicaciones, mantén presionada una app para bloquear su acceso cuando el modo Trabajo o Detox esté activo.</string>
    <string name="tutorial_slide_5_title">renombrar y personalizar</string>
    <string name="tutorial_slide_5_desc">mantén presionada cualquier aplicación en el cajón de apps para cambiar su nombre por uno más minimalista y libre de marcas.</string>
    <string name="tutorial_slide_6_title">modo detox absoluto</string>
    <string name="tutorial_slide_6_desc">inicia una sesión detox con tiempo personalizado y contraseña obligatoria para evitar desactivarlo antes de tiempo de forma impulsiva.</string>
    <string name="tutorial_slide_7_title">pausa consciente</string>
    <string name="tutorial_slide_7_desc">añade un temporizador de respiración antes de abrir cualquier aplicación marcada para reflexionar antes de caer en distracciones.</string>
    <string name="tutorial_slide_8_title">reloj y pantalla</string>
    <string name="tutorial_slide_8_desc">personaliza el estilo y tamaño del reloj, ajusta la alineación del texto y decide si mostrar u ocultar la barra de estado superior.</string>
