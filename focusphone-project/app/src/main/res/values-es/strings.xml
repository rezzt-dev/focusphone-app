    <!-- Settings Sections -->
    <string name="settings_section_tutorial">tutorial</string>
    <string name="settings_tutorial_title">tutorial interactivo</string>
    <string name="settings_tutorial_desc">aprende a usar el 100% de las funciones de focusphone</string>

    <!-- Tutorial Slides -->
    <string name="tutorial_slide_1_title">minimalismo e inicio</string>
    <string name="tutorial_slide_1_desc">tu pantalla principal limpia, libre de distracciones e iconos ruidosos, optimizada para centrarte en lo importante.</string>
    <string name="tutorial_slide_2_title">fijar aplicaciones</string>
    <string name="tutorial_slide_2_desc">manten presionado un espacio vacio en la pantalla de inicio o usa la seleccion de favoritos para fijar hasta 6 aplicaciones esenciales.</string>
    <string name="tutorial_slide_3_title">perfiles contextuales</string>
    <string name="tutorial_slide_3_desc">cambia de perfil (normal, trabajo o detox) desde el menu lateral para ajustar las aplicaciones visibles y bloquear distracciones.</string>
    <string name="tutorial_slide_4_title">bloquear aplicaciones</string>
    <string name="tutorial_slide_4_desc">en la lista de todas las aplicaciones, manten presionada una app para bloquear su acceso cuando el modo Trabajo o Detox este activo.</string>
    <string name="tutorial_slide_5_title">renombrar y personalizar</string>
    <string name="tutorial_slide_5_desc">manten presionada cualquier aplicacion en el cajon de apps para cambiar su nombre por uno mas minimalista y libre de marcas.</string>
    <string name="tutorial_slide_6_title">modo detox absoluto</string>
    <string name="tutorial_slide_6_desc">inicia una sesion detox con tiempo personalizado y contrasena obligatoria para evitar desactivarlo antes de tiempo de forma impulsiva.</string>
    <string name="tutorial_slide_7_title">pausa consciente</string>
    <string name="tutorial_slide_7_desc">anade un temporizador de respiracion antes de abrir cualquier aplicacion marcada para reflexionar antes de caer en distracciones.</string>
    <string name="tutorial_slide_8_title">reloj y pantalla</string>
    <string name="tutorial_slide_8_desc">personaliza el estilo y tamano del reloj, ajusta la alineacion del texto y decide si mostrar u ocultar la barra de estado superior.</string>
    <string name="tutorial_btn_next">siguiente</string>
    <string name="tutorial_btn_back">atras</string>
    <string name="tutorial_btn_finish">terminar</string>

