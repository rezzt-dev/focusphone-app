<?xml version="1.0" encoding="utf-8"?>
<!-- FocusPhone widget library: calendar week (4 x 1). Sizes follow the 70 x n - 30 launcher formula. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:minWidth="250dp"
    android:minHeight="40dp"
    android:minResizeWidth="250dp"
    android:minResizeHeight="40dp"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_calendar_week"
    android:previewLayout="@layout/widget_calendar_week"
    android:previewImage="@drawable/wg_preview_tile_calendar_week"
    android:description="@string/wg_desc_calendar_week"
    android:widgetCategory="home_screen"
    tools:targetApi="31" />
