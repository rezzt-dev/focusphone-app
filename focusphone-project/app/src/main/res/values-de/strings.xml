    <!-- Tutorial Slides -->
    <string name="tutorial_slide_1_title">minimalismus &amp; startseite</string>
    <string name="tutorial_slide_1_desc">dein sauberer startbildschirm, frei von ablenkenden, lautstarken symbolen, optimiert auf das wesentliche.</string>
    <string name="tutorial_slide_2_title">apps anheften</string>
    <string name="tutorial_slide_2_desc">halte einen leeren bereich auf dem startbildschirm gedrückt oder nutze die favoritenauswahl, um bis zu 6 wichtige apps anzuheften.</string>
    <string name="tutorial_slide_3_title">kontextbezogene profile</string>
    <string name="tutorial_slide_3_desc">wechsle im seitenmenü das profil (normal, arbeit oder detox), um sichtbare apps zu filtern und ablenkungen zu minimieren.</string>
    <string name="tutorial_slide_4_title">ablenkungen blockieren</string>
    <string name="tutorial_slide_4_desc">halte eine app in der app-liste gedrückt, um den zugriff während der arbeit oder im detox-modus zu sperren.</string>
    <string name="tutorial_slide_5_title">umbenennen &amp; anpassen</string>
    <string name="tutorial_slide_5_desc">halte eine app in der app-liste gedrückt, um sie umzubenennen und ihr einen minimalistischen, markenfreien namen zu geben.</string>
    <string name="tutorial_slide_6_title">absoluter detox-modus</string>
    <string name="tutorial_slide_6_desc">starte eine detox-sitzung mit benutzerdefinierter dauer und passwortsperre, um ein vorzeitiges abbrechen zu verhindern.</string>
    <string name="tutorial_slide_7_title">bewusste pause</string>
    <string name="tutorial_slide_7_desc">aktiviere einen atem-timer vor dem öffnen blockierter apps, um innezuhalten und ablenkungen zu reflektieren.</string>
    <string name="tutorial_slide_8_title">uhrzeit &amp; anpassung</string>
    <string name="tutorial_slide_8_desc">personalisiere den stil und die größe der uhr, passe die textausrichtung an und blende die statusleiste oben ein oder aus.</string>
    <string name="tutorial_btn_next">weiter</string>
    <string name="tutorial_btn_back">zurück</string>
    <string name="tutorial_btn_finish">beenden</string>

