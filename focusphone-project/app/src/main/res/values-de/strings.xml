    <!-- Enhanced Onboarding -->
    <string name="onboarding_step_welcome_title">willkommen bei focusphone.</string>
    <string name="onboarding_step_welcome_body">dein digitaler raum, vereinfacht. wir glauben, dein telefon sollte dir dienen, nicht ablenken.</string>
    <string name="onboarding_step_welcome_tagline">weniger lärm. mehr fokus.</string>
    <string name="onboarding_step_philosophy_title">die idee ist einfach.</string>
    <string name="onboarding_step_philosophy_body">nur die apps, die du wirklich brauchst. keine symbole, die um aufmerksamkeit schreien. kein endloses scrollen. einfach ruhe.</string>
    <string name="onboarding_step_launcher_title">als standard-launcher festlegen.</string>
    <string name="onboarding_step_launcher_body">um focusphone vollständig zu erleben, mache es zu deinem startbildschirm. tippe unten, um die systemeinstellungen zu öffnen.</string>
    <string name="onboarding_step_launcher_action">launcher-einstellungen öffnen</string>
    <string name="onboarding_step_launcher_verified">launcher korrekt eingestellt.</string>
    <string name="onboarding_step_launcher_not_verified">noch nicht als standard festgelegt.</string>
    <string name="onboarding_step_apps_title">wähle deine essentials.</string>
    <string name="onboarding_step_apps_body">wähle bis zu 10 apps, die wirklich zählen. alles andere bleibt aus dem blickfeld, aber erreichbar.</string>
    <string name="onboarding_step_apps_action">apps auswählen</string>
    <string name="onboarding_step_profiles_title">profile für jeden moment.</string>
    <string name="onboarding_step_profiles_body">normal für alles. arbeit, um ablenkungen zu blockieren. detox für komplette digitale stille.</string>
    <string name="onboarding_step_customize_title">mach es zu deinem.</string>
    <string name="onboarding_step_customize_body">wähle ein design und einen uhrstil, die zu dir passen. du kannst es jederzeit ändern.</string>
    <string name="onboarding_step_complete_title">du bist bereit.</string>
    <string name="onboarding_step_complete_body">dein ruhiger, fokussierter startbildschirm wartet. denk daran: wische nach links für das menü, nach rechts für benachrichtigungen.</string>
    <string name="onboarding_step_complete_action">focusphone betreten</string>

    <!-- Tutorial Coach Marks -->
    <string name="tutorial_coach_home_title">dein ruhiges zuhause</string>
    <string name="tutorial_coach_home_desc">das ist dein neuer startbildschirm. nur die uhrzeit, das datum und deine gewählten apps. keine symbole, kein lärm.</string>
    <string name="tutorial_coach_menu_title">das menü</string>
    <string name="tutorial_coach_menu_desc">wische nach links, um das menü zu öffnen. von hier aus kannst du auf alle apps, einstellungen und profile zugreifen.</string>
    <string name="tutorial_coach_apps_title">apps hinzufügen</string>
    <string name="tutorial_coach_apps_desc">tippe im menü auf \"dashboard bearbeiten\", um bis zu 10 apps zu wählen. halte eine app gedrückt für optionen oder ziehe sie, um sie zu verschieben.</string>
    <string name="tutorial_coach_profile_title">kontextbezogene profile</string>
    <string name="tutorial_coach_profile_desc">tippe auf deinen profilnamen, um den modus zu wechseln. arbeit blockiert ablenkungen. detox blockiert alles.</string>
    <string name="tutorial_coach_block_title">apps blockieren</string>
    <string name="tutorial_coach_block_desc">halte in der app-liste eine app gedrückt, um sie im arbeits- oder detox-modus zu sperren.</string>
    <string name="tutorial_coach_rename_title">apps umbenennen</string>
    <string name="tutorial_coach_rename_desc">halte eine beliebige app gedrückt und wähle umbenennen, um ihr einen sauberen, minimalistischen namen zu geben.</string>
    <string name="tutorial_coach_detox_title">detox-modus</string>
    <string name="tutorial_coach_detox_desc">starte eine detox-sitzung, wenn du totalen fokus brauchst. setze eine dauer und ein passwort, um dabei zu bleiben.</string>
    <string name="tutorial_coach_customize_title">tiefe anpassung</string>
    <string name="tutorial_coach_customize_desc">erkunde die einstellungen, um designs, schriftarten, uhrstile, ausrichtung und vieles mehr zu ändern.</string>
    <string name="tutorial_coach_got_it">verstanden</string>

