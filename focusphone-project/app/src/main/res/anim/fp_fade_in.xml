<?xml version="1.0" encoding="utf-8"?>
<!--
    Incoming screen: fades in while settling from a hair below full size, so a new screen
    arrives rather than blinks on. Also plays on the screen revealed by a close.
-->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/linear_out_slow_in"
    android:shareInterpolator="true">
    <alpha
        android:duration="@integer/fp_screen_enter_duration"
        android:fromAlpha="0.0"
        android:toAlpha="1.0" />
    <scale
        android:duration="@integer/fp_screen_enter_duration"
        android:fromXScale="0.98"
        android:fromYScale="0.98"
        android:pivotX="50%"
        android:pivotY="50%"
        android:toXScale="1.0"
        android:toYScale="1.0" />
</set>
