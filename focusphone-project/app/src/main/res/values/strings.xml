    <!-- Enhanced Onboarding -->
    <string name="onboarding_step_welcome_title">welcome to focusphone.</string>
    <string name="onboarding_step_welcome_body">your digital space, simplified. we believe your phone should serve you, not distract you.</string>
    <string name="onboarding_step_welcome_tagline">less noise. more focus.</string>
    <string name="onboarding_step_philosophy_title">the idea is simple.</string>
    <string name="onboarding_step_philosophy_body">only the apps you truly need. no icons screaming for attention. no infinite scrolls. just calm.</string>
    <string name="onboarding_step_launcher_title">set as default launcher.</string>
    <string name="onboarding_step_launcher_body">to experience focusphone fully, make it your home screen. tap below to open system settings.</string>
    <string name="onboarding_step_launcher_action">open launcher settings</string>
    <string name="onboarding_step_launcher_verified">launcher set correctly.</string>
    <string name="onboarding_step_launcher_not_verified">not set as default yet.</string>
    <string name="onboarding_step_apps_title">choose your essentials.</string>
    <string name="onboarding_step_apps_body">select up to 10 apps that truly matter. everything else stays out of sight, but within reach.</string>
    <string name="onboarding_step_apps_action">select apps</string>
    <string name="onboarding_step_profiles_title">profiles for every moment.</string>
    <string name="onboarding_step_profiles_body">normal for everything. work to block distractions. detox for complete digital silence.</string>
    <string name="onboarding_step_customize_title">make it yours.</string>
    <string name="onboarding_step_customize_body">pick a theme and clock style that feel right. you can always change this later.</string>
    <string name="onboarding_step_complete_title">you are ready.</string>
    <string name="onboarding_step_complete_body">your calm, focused home screen awaits. remember: swipe left for the menu, swipe right for notifications.</string>
    <string name="onboarding_step_complete_action">enter focusphone</string>

    <!-- Tutorial Coach Marks -->
    <string name="tutorial_coach_home_title">your calm home</string>
    <string name="tutorial_coach_home_desc">this is your new home. just the time, the date, and your chosen apps. no icons, no noise.</string>
    <string name="tutorial_coach_menu_title">the menu</string>
