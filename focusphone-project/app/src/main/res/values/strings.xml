    <!-- Tutorial Slides -->
    <string name="tutorial_slide_1_title">minimalism &amp; home</string>
    <string name="tutorial_slide_1_desc">your clean home screen, free from distracting, noisy icons, optimized to help you focus on what matters most.</string>
    <string name="tutorial_slide_2_title">pin essential apps</string>
    <string name="tutorial_slide_2_desc">long press an empty space on the home screen or use the favorites selector to pin up to 6 of your most important apps.</string>
    <string name="tutorial_slide_3_title">contextual profiles</string>
    <string name="tutorial_slide_3_desc">switch between profiles (normal, work, or detox) from the side menu to control visible apps and filter distractions.</string>
    <string name="tutorial_slide_4_title">block distractions</string>
    <string name="tutorial_slide_4_desc">in the all apps list, long press any app to block its access whenever the work or detox profile is active.</string>
    <string name="tutorial_slide_5_title">rename &amp; customize</string>
    <string name="tutorial_slide_5_desc">long press any app in the app drawer to rename it to something clean, minimalist, and brand-free.</string>
    <string name="tutorial_slide_6_title">absolute detox mode</string>
    <string name="tutorial_slide_6_desc">start a detox session with a custom duration and a mandatory password to prevent impulsively turning it off early.</string>
    <string name="tutorial_slide_7_title">conscious pause</string>
    <string name="tutorial_slide_7_desc">add a breathing timer before opening selected apps to pause and reflect before falling into distractions.</string>
    <string name="tutorial_slide_8_title">clock &amp; customization</string>
    <string name="tutorial_slide_8_desc">customize the clock style and size, adjust text alignment, and choose whether to show or hide the top system status bar.</string>
