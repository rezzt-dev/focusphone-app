    <string name="tutorial_coach_apps_desc">tap \"select apps\" to choose up to 10 favourites. long press an app to remove it.</string>
    <string name="tutorial_coach_profile_title">contextual profiles</string>
    <string name="tutorial_coach_profile_desc">tap your profile name to switch modes. work blocks distractions. detox blocks everything.</string>
