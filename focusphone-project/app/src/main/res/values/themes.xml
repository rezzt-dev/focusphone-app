    <!-- ═══════════════════════════════════════════════════════════════
         COMMON WIDGET STYLES
         ═══════════════════════════════════════════════════════════════ -->

    <!-- Root: required by AAPT as implicit parent of FocusPhone.* widget styles -->
    <style name="FocusPhone" parent="android:Widget" />

    <!--
        Slider used by every settings screen.

        Material 3 leaves the inactive track on its baseline palette, which rendered as a
        purple bar inside an otherwise monochrome launcher. Every part is bound to the
        active theme's own colours instead.
    -->
    <style name="FocusPhone.Slider" parent="Widget.Material3.Slider">
        <item name="thumbColor">@color/color_slider_active</item>
        <item name="trackColorActive">@color/color_slider_active</item>
        <item name="trackColorInactive">@color/color_slider_track_inactive</item>
        <item name="haloColor">@color/color_slider_halo</item>
        <item name="tickVisible">false</item>
        <item name="labelBehavior">gone</item>
        <item name="trackHeight">4dp</item>
        <item name="thumbRadius">7dp</item>
        <item name="haloRadius">20dp</item>
    </style>

    <!-- Ripple background for clickable items -->
    <style name="FocusPhone.RippleItem">
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- App item in the home launcher list -->
    <style name="FocusPhone.AppItem" parent="FocusPhone.RippleItem">
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">@dimen/spacing_xl</item>
        <item name="android:paddingEnd">@dimen/spacing_xl</item>
        <item name="android:paddingTop">@dimen/app_item_vertical_padding</item>
        <item name="android:paddingBottom">@dimen/app_item_vertical_padding</item>
        <item name="android:textSize">@dimen/text_app_item</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- Bottom action buttons (text buttons, minimal) -->
    <style name="FocusPhone.ActionButton">
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:textSize">@dimen/text_action_button</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:paddingStart">@dimen/spacing_l</item>
        <item name="android:paddingEnd">@dimen/spacing_l</item>
        <item name="android:paddingTop">@dimen/spacing_m</item>
        <item name="android:paddingBottom">@dimen/spacing_m</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Custom Material AlertDialog styling -->
    <style name="FocusPhone.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <!-- Text styling -->
        <item name="materialAlertDialogTitleTextStyle">@style/FocusPhone.DialogTitleTextStyle</item>
        <item name="materialAlertDialogBodyTextStyle">@style/FocusPhone.DialogBodyTextStyle</item>
        <!-- Button styling -->
        <item name="buttonBarPositiveButtonStyle">@style/FocusPhone.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/FocusPhone.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/FocusPhone.DialogButton</item>
    </style>

    <!--
        materialAlertDialogTitleTextStyle and materialAlertDialogBodyTextStyle are *view*
        styles, not text appearances: the title TextView in m3_alert_dialog_title.xml declares
        no layout_width/layout_height and takes them from this style. Parenting it on a
        TextAppearance made every MaterialAlertDialog crash on inflation ("You must supply a
        layout_width attribute"). Keep both parented on the Material dialog widget styles;
        MaterialAlertDialogThemeTest guards this for every theme.
    -->
    <style name="FocusPhone.DialogTitleTextStyle" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textAppearance">@style/TextAppearance.Material3.TitleMedium</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="FocusPhone.DialogBodyTextStyle" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textAppearance">@style/TextAppearance.Material3.BodyMedium</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="FocusPhone.DialogButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="rippleColor">?android:attr/textColorSecondary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Widget launch trampoline (WidgetLaunchActivity): finishes in onCreate, so the
         system must not draw a starting window for it either. -->
    <style name="Theme.FocusPhone.WidgetTrampoline" parent="Theme.FocusPhone.Slate">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
    </style>

</resources>
