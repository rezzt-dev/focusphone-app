<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ═══════════════════════════════════════════════════════════════
         BASE THEME  –  attributes shared across all 4 themes
         ═══════════════════════════════════════════════════════════════ -->
    <!-- ── Root: required by AAPT as implicit parent of Theme.FocusPhone.* ── -->
    <style name="Theme.FocusPhone" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:navigationBarColor">@color/transparent</item>
    </style>

    <!-- ── Shared base attrs ─────────────────────────────────────────────── -->
    <style name="Base.Theme.FocusPhone" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="28">shortEdges</item>
        <!-- Global default font: regular weight throughout the entire app -->
        <item name="android:fontFamily">sans-serif</item>
        <item name="materialAlertDialogTheme">@style/FocusPhone.MaterialAlertDialog</item>
    </style>

    <!-- Material's dark base plus the same FocusPhone window and typography contract. -->
    <style name="Base.Theme.FocusPhone.Dark" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="28">shortEdges</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="materialAlertDialogTheme">@style/FocusPhone.MaterialAlertDialog</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════════
         THEME 1: OFF-WHITE  (light, cool grey)
         ═══════════════════════════════════════════════════════════════ -->
    <style name="Theme.FocusPhone.OffWhite" parent="Base.Theme.FocusPhone">
        <item name="android:colorBackground">@color/ow_bg_primary</item>
        <item name="colorSurface">@color/ow_bg_secondary</item>
        <item name="colorOutline">@color/ow_accent</item>
        <item name="android:textColorPrimary">@color/ow_text_primary</item>
        <item name="android:textColorSecondary">@color/ow_text_secondary</item>
        <item name="colorOnBackground">@color/ow_text_primary</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:navigationBarColor">@color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>

        <!-- Material 3 switch / control coloring — use direct @color refs, never ?attr -->
        <item name="colorPrimary">@color/ow_text_primary</item>
        <item name="colorOnPrimary">@color/ow_bg_primary</item>
        <item name="colorPrimaryContainer">@color/ow_text_secondary</item>
        <item name="colorOnPrimaryContainer">@color/ow_bg_primary</item>
        <item name="colorSecondary">@color/ow_text_secondary</item>
        <item name="colorSurfaceVariant">@color/ow_bg_secondary</item>
        <item name="colorOnSurface">@color/ow_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/ow_text_secondary</item>
        <item name="colorControlNormal">@color/ow_text_secondary</item>
        <item name="colorControlActivated">@color/ow_text_primary</item>
        <item name="colorControlHighlight">@color/ow_ripple</item>

        <!--
            Neutral Material 3 roles.

            The four themes inherit from the Material 3 baseline, whose unset roles are
            purple; anything FocusPhone does not name explicitly leaks that colour into the
            UI (the slider track was the visible case). Each role is redirected to one of
            this theme's own colours so the launcher stays monochrome by construction.
        -->
        <item name="colorAccent">?android:attr/textColorPrimary</item>
        <item name="colorPrimaryInverse">?android:attr/colorBackground</item>
        <item name="colorSecondaryContainer">?attr/colorSurfaceVariant</item>
        <item name="colorOnSecondaryContainer">?android:attr/textColorPrimary</item>
        <item name="colorTertiary">?android:attr/textColorSecondary</item>
        <item name="colorOnTertiary">?android:attr/colorBackground</item>
        <item name="colorTertiaryContainer">?attr/colorSurfaceVariant</item>
        <item name="colorOnTertiaryContainer">?android:attr/textColorPrimary</item>
        <item name="colorOutlineVariant">?attr/colorOutline</item>
        <item name="colorSurfaceInverse">?android:attr/textColorPrimary</item>
        <item name="colorOnSurfaceInverse">?android:attr/colorBackground</item>
        <item name="colorSurfaceContainerLowest">?android:attr/colorBackground</item>
        <item name="colorSurfaceContainerLow">?android:attr/colorBackground</item>
        <item name="colorSurfaceContainer">?attr/colorSurface</item>
        <item name="colorSurfaceContainerHigh">?attr/colorSurface</item>
        <item name="colorSurfaceContainerHighest">?attr/colorSurfaceVariant</item>

        <!-- Widget styles -->
        <item name="sliderStyle">@style/FocusPhone.Slider</item>
    </style>

