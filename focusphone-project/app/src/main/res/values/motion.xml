<?xml version="1.0" encoding="utf-8"?>
<!--
    Motion tokens. Every animation in FocusPhone draws its timing from here so the app moves
    with one rhythm: quick to answer a touch, slower and softer to settle.
-->
<resources>
    <!-- Press feedback on text rows (see animator/fp_press_feedback.xml). -->
    <integer name="fp_press_in_duration">90</integer>
    <integer name="fp_press_out_duration">220</integer>

    <!-- Screen transitions (see anim/fp_fade_in.xml and anim/fp_fade_out.xml). -->
    <integer name="fp_screen_enter_duration">260</integer>
    <integer name="fp_screen_exit_duration">170</integer>
</resources>
