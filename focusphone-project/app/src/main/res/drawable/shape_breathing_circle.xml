<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <!-- Semi-transparent halo using theme-aware ripple color (adapts to light/dark) -->
    <solid android:color="?attr/colorControlHighlight" />
    <!-- Fine outline matching the secondary text color of the current theme -->
    <stroke
        android:width="1.5dp"
        android:color="?attr/android:textColorSecondary" />
</shape>
