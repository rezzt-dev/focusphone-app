<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ── Permissions ──────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <uses-permission android:name="android.permission.BIND_APPWIDGET" />
    <!-- QUERY_ALL_PACKAGES is required for launcher functionality -->
    <!-- REQUEST_DELETE_PACKAGES is required since Android 9 for uninstall intents -->
    <!-- Play Store declaration form must be submitted for QUERY_ALL_PACKAGES -->

    <application
        android:name=".FocusPhoneApp"
        android:allowBackup="false"
        android:icon="@mipmap/icon_alfa_version_round"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/icon_alfa_version_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FocusPhone.Slate"
        android:localeConfig="@xml/locales_config">

        <!-- ── Home (Launcher) Activity ───────────────────────────── -->
        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter android:priority="1">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ── App Selection Activity ─────────────────────────────── -->
        <activity
            android:name=".ui.appselect.AppSelectActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- ── Settings Activity ──────────────────────────────────── -->
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false" />

        <!-- ── All Apps Activity ──────────────────────────────────── -->
        <activity
            android:name=".ui.allapps.AllAppsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- ── Onboarding Activity ────────────────────────────────── -->
        <activity
            android:name=".ui.onboarding.OnboardingActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <!-- ── Conscious Pause Activity ───────────────────────────── -->
        <activity
            android:name=".ui.pause.ConsciousPauseActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <!-- ── Detox Blocked Activity ─────────────────────────────── -->
        <activity
            android:name=".ui.detox.DetoxBlockedActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <!-- ── Home Layout Activity ───────────────────────────────── -->
        <activity
            android:name=".ui.settings.HomeLayoutActivity"
            android:exported="false" />

        <!-- ── Permissions Activity ───────────────────────────────── -->
        <activity
            android:name=".ui.settings.PermissionsActivity"
            android:exported="false" />

        <!-- ── Settings Sub-Activities ──────────────────────────────── -->
        <activity
            android:name=".ui.settings.AppearanceSettingsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.settings.HomeSettingsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.settings.FocusSettingsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.settings.NotificationSettingsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.settings.SystemSettingsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.settings.AboutSettingsActivity"
            android:exported="false" />

        <!-- ── Widget Configuration Activity (legacy, kept for compatibility) ── -->
        <activity
            android:name=".ui.widget.WidgetConfigActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|density|keyboardHidden"
            android:exported="false" />

        <!-- ── Widget Picker Activity ─────────────────────────────── -->
        <activity
            android:name=".ui.widget.WidgetPickerActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|density|keyboardHidden"
            android:exported="false" />

        <!-- ── Accessibility Service (system-level app blocking) ────── -->
        <service
            android:name=".service.FocusAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- ── Notification Listener Service (badge counts) ───────────── -->
        <service
            android:name=".service.FocusNotificationService"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>

</manifest>