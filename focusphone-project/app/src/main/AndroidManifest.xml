<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ── Permissions ──────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Only QUERY_ALL_PACKAGES is required for launcher functionality -->
    <!-- Play Store declaration form must be submitted for this permission -->

    <application
        android:name=".FocusPhoneApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/icon_alfa_version_round"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/icon_alfa_version_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FocusPhone.Slate"
        android:localeConfig="@xml/locales_config">

        <!-- ── Home (Launcher) Activity ───────────────────────────── -->
        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter android:priority="1">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ── App Selection Activity ─────────────────────────────── -->
        <activity
            android:name=".ui.appselect.AppSelectActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- ── Settings Activity ──────────────────────────────────── -->
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false" />

        <!-- ── All Apps Activity ──────────────────────────────────── -->
        <activity
            android:name=".ui.allapps.AllAppsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- ── Onboarding Activity ────────────────────────────────── -->
        <activity
            android:name=".ui.onboarding.OnboardingActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <!-- ── Conscious Pause Activity ───────────────────────────── -->
        <activity
            android:name=".ui.pause.ConsciousPauseActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <!-- ── Detox Blocked Activity ─────────────────────────────── -->
        <activity
            android:name=".ui.detox.DetoxBlockedActivity"
            android:exported="false"
            android:launchMode="singleTop" />

    </application>

</manifest>